# Copy to .env.local for local development. All values are optional locally.

# Postgres connection string (Neon). Leave empty to use the embedded local
# database in ./.pglite. On Vercel, the Neon integration sets this for you.
DATABASE_URL=

# --- Email (Resend) ---------------------------------------------------------
# Leave RESEND_API_KEY empty locally: emails are saved to ./.outbox and shown
# at http://localhost:3000/dev/emails instead of being sent.
RESEND_API_KEY=
# Sender. Must be on a domain verified in Resend.
EMAIL_FROM="Mindspace <bookings@your-verified-domain>"
# Where replies go (default: mindspace.club@novasbe.pt).
EMAIL_REPLY_TO=mindspace.club@novasbe.pt

# Base URL for links in emails. On Vercel it defaults to the production domain.
APP_URL=

# Protects the daily reminder job (/api/cron/reminders). Required on Vercel:
# set any long random string; Vercel sends it automatically to cron jobs.
CRON_SECRET=
