{
  "name": "mindspace-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "db:reset": "rm -rf .pglite && npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "typecheck": "next typegen && tsc --noEmit",
    "vercel-build": "npm run db:migrate && next build",
    "test": "PGLITE_DIR=memory:// TSX_TSCONFIG_PATH=tests/tsconfig.json tsx --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@neondatabase/serverless": "^1.2.1",
    "@react-email/components": "1.0.12",
    "@vercel/blob": "2.9.0",
    "drizzle-orm": "^0.45.4",
    "ics": "3.12.1",
    "lucide-react": "^1.81.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.38.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
